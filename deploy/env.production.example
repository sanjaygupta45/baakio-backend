# Store the completed file as /opt/baakio/.env with mode 0600 on the VM.
# Compose builds the verified-TLS JDBC URL from these Aiven connection settings.
DB_HOST=
DB_PORT=
DB_NAME=baakio
DB_USER=
DB_PASSWORD=
AIVEN_CA_HOST_PATH=/opt/baakio/certs/aiven-ca.pem
AIVEN_TRUSTSTORE_HOST_PATH=/opt/baakio/certs/aiven-truststore.p12
AIVEN_TRUSTSTORE_PASSWORD=
RABBITMQ_HOST=
RABBITMQ_PORT=5671
RABBITMQ_VHOST=
RABBITMQ_USER=
RABBITMQ_PASSWORD=
OTP_HASH_SECRET=
GCP_PROJECT_ID=
GCS_BUCKET=
FRONTEND_ORIGIN=https://frontend.example.com
API_HOSTNAME=api.example.com
FAST2SMS_API_KEY=
FAST2SMS_OTP_TEMPLATE_ID=
MISTRAL_API_KEY=
