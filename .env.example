# Local development only. Replace these values before sharing the app.
MYSQL_DATABASE=baakio
MYSQL_USER=baakio
MYSQL_PASSWORD=baakio-local-change-this
MYSQL_ROOT_PASSWORD=baakio-root-local-change-this
MYSQL_HOST_PORT=3307
SPRING_PROFILES_ACTIVE=dev
OTP_CHANNEL=SMS
SMS_NOTIFICATION_PROVIDER=development
WHATSAPP_NOTIFICATION_PROVIDER=development
EMAIL_NOTIFICATION_PROVIDER=development
OTP_EXPIRES_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_HOUR=5
OTP_MAX_ATTEMPTS=5
# Local-development-only OTP hash secret; replace with a unique secret of at least 32 characters outside development.
OTP_HASH_SECRET=baakio-local-development-otp-pepper
# Fast2SMS and SMTP are not used while the dev profile is active.
FAST2SMS_API_KEY=
FAST2SMS_BASE_URL=https://www.fast2sms.com
FAST2SMS_OTP_TEMPLATE_ID=
FAST2SMS_OTP_VARIABLES_TEMPLATE=
FAST2SMS_QUICK_SMS_ROUTE=q
FAST2SMS_WHATSAPP_VERSION=v26.0
FAST2SMS_WHATSAPP_PHONE_NUMBER_ID=
FAST2SMS_WHATSAPP_OTP_TEMPLATE_NAME=
FAST2SMS_WHATSAPP_OTP_BUTTON_INDEX=
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
NOTIFICATION_EMAIL_FROM=
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
